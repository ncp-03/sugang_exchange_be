+                .filter(t -> t.getOffering().getId().equals(target.getId()))
+                .toList();
+        for (ClassTime t : targetTimes) {
+            for (ClassTime o : all) {
+                if (!o.getOffering().getId().equals(target.getId()) && t.overlaps(o)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
 }
