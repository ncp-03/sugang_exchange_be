# ============================================================
# 수강신청 교환 마켓 API 서버 환경변수 (NCP 배포용)
#
# 저장 위치 : API 서버 2대 각각의  /etc/course-change.env   (chmod 600)
# 내용      : 두 서버 모두 똑같이. 단, APP_MATCHING_EXPIRE_SCHEDULER만 서버별로 다름
# 형식      : KEY=값 한 줄씩 (export 쓰지 않음). 값에 & 가 있으면 큰따옴표로 감싸기
# 적용      : 수정 후 sudo systemctl restart course-change
# 주의      : 실제 값을 채운 파일은 GitHub·단톡방에 올리지 않기 (서버 안에서만 보관)
# ============================================================

# ---------- [인프라 담당이 채울 것] ----------

# Cloud DB for MySQL (Private Subnet)
#  - DB 'course_change' 를 미리 만들어 두기 (문자셋 utf8mb4)
#  - DB_USERNAME 계정에 이 DB의 테이블 생성·변경 권한 주기
#    (첫 실행 때 Flyway가 테이블과 샘플 학생 데이터를 자동으로 만듦)
#  - DB의 ACG: 3306은 API 서버 ACG에서만 허용
DB_URL="jdbc:mysql://<Cloud DB의 Private 도메인 또는 IP>:3306/course_change?serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
DB_USERNAME=<앱 전용 DB 계정>
DB_PASSWORD=<DB 비밀번호>

# 로그인 토큰 서명 키
#  - 아무 서버에서 `openssl rand -hex 32` 를 한 번만 실행하고, 나온 값을 두 서버에 똑같이 넣기
#  - 두 서버 값이 다르면 로그인은 되는데 다음 요청에서 401이 랜덤하게 발생
APP_AUTH_SECRET=<랜덤 64자>

# 사용자가 브라우저 주소창에 입력하는 주소 = LB 접속 주소
#  - http:// 포함, 끝에 / 없이. (HTTPS를 쓰게 되면 https://...)
#  - LB 주소가 나온 뒤에 채우기. 이 값이 틀리면 로그인만 403
CORS_ALLOWED_ORIGINS=http://<LB 접속 주소>

# ---------- [고정값 — 그대로 두기] ----------
# TOKEN = 로그인 토큰이 있어야만 API 사용 (공개 서버는 반드시 TOKEN)
APP_AUTH_MODE=TOKEN

# ---------- [서버별로 다름] ----------
# 만료된 매칭 세션을 정리하는 스케줄러. API 서버 1번 = true, API 서버 2번 = false
APP_MATCHING_EXPIRE_SCHEDULER=true

# ---------- [부하테스트 담당이 바꿈] ----------
# 락 없음 = NONE, 락 있음 = PESSIMISTIC. 바꾼 뒤 두 서버 모두 재시작
APP_MATCHING_LOCK_MODE=NONE
