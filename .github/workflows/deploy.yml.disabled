# [비활성 상태] 서버 준비가 끝나면 파일명을 deploy.yml 로 바꿔 커밋하세요.
# CI(테스트)가 성공한 뒤 jar를 만들어 API 서버들에 한 대씩 배포한다.
# 경로: GitHub Actions → Vue 서버(Public, SSH 중계) → API 서버(Private)
# 필요한 GitHub Secrets: SSH_PRIVATE_KEY, BASTION_HOST, API_HOSTS, SSH_USER (deploy/README.md 참고)
name: Deploy

on:
  workflow_run:
    workflows: ["CI"]
    types: [completed]
    branches: [main, "wip/**"]
  workflow_dispatch:

concurrency:
  group: deploy
  cancel-in-progress: false

jobs:
  deploy:
    name: API 서버 배포 (한 대씩)
    runs-on: ubuntu-latest
    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.workflow_run.head_sha || github.sha }}

      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4

      # 테스트는 CI에서 이미 했으므로 여기서는 jar만 만든다 → build/libs/app.jar
      - name: jar 빌드
        run: ./gradlew bootJar -x test --no-daemon

      - name: SSH 설정 (Vue 서버를 거쳐 Private 서버로 접속)
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          BASTION_HOST: ${{ secrets.BASTION_HOST }}
          API_HOSTS: ${{ secrets.API_HOSTS }}
          SSH_USER: ${{ secrets.SSH_USER }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh && chmod 700 ~/.ssh
          printf '%s\n' "$SSH_PRIVATE_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          {
            echo "Host bastion"
            echo "  HostName $BASTION_HOST"
            echo "  User $SSH_USER"
            echo "  IdentityFile ~/.ssh/deploy_key"
            echo "  StrictHostKeyChecking accept-new"
            i=0
            for h in $API_HOSTS; do
              i=$((i+1))
              echo "Host api$i"
              echo "  HostName $h"
              echo "  User $SSH_USER"
              echo "  IdentityFile ~/.ssh/deploy_key"
              echo "  ProxyJump bastion"
              echo "  StrictHostKeyChecking accept-new"
            done
          } > ~/.ssh/config
          chmod 600 ~/.ssh/config
          # 접속 확인 (여기서 막히면 ACG 22번 또는 키 문제)
          ssh -o ConnectTimeout=15 bastion 'echo bastion ok'

      - name: 서버별 롤링 배포
        env:
          API_HOSTS: ${{ secrets.API_HOSTS }}
        run: |
          set -euo pipefail
          i=0
          for h in $API_HOSTS; do
            i=$((i+1))
            echo "=== api$i ($h) 배포 ==="
            scp build/libs/app.jar api$i:/opt/course-change/app.jar.new
            ssh api$i 'bash -s' <<'REMOTE'
          set -euo pipefail
          SUDO=""; [ "$(id -u)" != 0 ] && SUDO="sudo"
          cd /opt/course-change
          [ -f app.jar ] && cp app.jar app.jar.prev
          mv app.jar.new app.jar
          $SUDO systemctl restart course-change
          # 최대 90초 동안 헬스체크
          for n in $(seq 1 45); do
            if curl -fsS http://localhost:8080/actuator/health >/dev/null 2>&1; then
              echo "health OK"; exit 0
            fi
            sleep 2
          done
          echo "health FAILED → 이전 jar로 롤백"
          [ -f app.jar.prev ] && cp app.jar.prev app.jar && $SUDO systemctl restart course-change
          exit 1
          REMOTE
          done
